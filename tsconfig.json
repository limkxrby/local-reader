{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM"],
    "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "noEmit": true,
    "esModuleInterop": true, "skipLibCheck": true,
    "types": ["chrome", "node"]
  },
  "include": ["src", "tests", "playwright.config.ts", "vitest.config.ts"]
}
